{
  "name": "@subhog/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "prestart": "npm --prefix ../.. run build --workspace=@subhog/api-client",
    "start": "expo start",
    "preandroid": "npm --prefix ../.. run build --workspace=@subhog/api-client",
    "android": "expo start --android",
    "preios": "npm --prefix ../.. run build --workspace=@subhog/api-client",
    "ios": "expo start --ios",
    "preweb": "npm --prefix ../.. run build --workspace=@subhog/api-client",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm --prefix ../.. run build --workspace=@subhog/api-client",
    "test": "node --experimental-strip-types --test tests/api-config.test.ts src/adapters/posthog-config.test.ts src/features/profile/profile-name.test.ts src/features/subscriptions/subscription-controller.test.ts",
    "prebuild": "npm --prefix ../.. run build --workspace=@subhog/api-client",
    "build": "expo export --platform web",
    "eas-build-post-install": "npm --prefix ../.. run build --workspace=@subhog/api-client"
  },
  "dependencies": {
    "@subhog/api-client": "*",
    "@subhog/contracts": "*",
    "@subhog/domain": "*",
    "@clerk/expo": "^4.6.6",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^5.0.0-preview.4",
    "posthog-react-native": "^4.74.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {}
}
