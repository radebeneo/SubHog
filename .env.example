# Required public Clerk key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# Optional: leave blank until a backend exists. Signed-in tabs show empty data without API calls.
# Once deployed, use the public API origin including /api/v1.
# Example: EXPO_PUBLIC_API_BASE_URL=https://your-api-host/api/v1
# Never put backend secrets in Expo config.
EXPO_PUBLIC_API_BASE_URL=

# Optional PostHog analytics
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
