# Public key for the matching Clerk DEVELOPMENT instance.
# Replace the example with the real pk_test_... key; keep existing local values.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Public Convex DEVELOPMENT deployment URL; see docs/convex-setup.md.
# Blank preserves Unit 1's in-memory subscription flow.
EXPO_PUBLIC_CONVEX_URL=


# Set CLERK_JWT_ISSUER_DOMAIN on the Convex deployment, not in Expo public config.
# Convex CLI writes CONVEX_DEPLOYMENT to ignored .env.local during setup.
# Never expose CONVEX_DEPLOY_KEY, Clerk secret keys, or tokens as EXPO_PUBLIC_*.
# The disconnected EXPO_PUBLIC_API_BASE_URL setting is obsolete.

# Optional PostHog analytics
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
